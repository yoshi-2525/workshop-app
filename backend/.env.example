# development 以外にすると、JWT_SECRET_KEY が初期値・32文字未満のとき起動を止める
APP_ENV=development
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=workshop
# 32文字以上のランダムな値。例: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change_this_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_BYTES=5242880
LOGIN_MAX_FAILURES=10
LOGIN_FAILURE_WINDOW_SECONDS=900
# Stripe(参加費のオンライン決済)。秘密鍵が空ならオンライン決済は使えず、当日払いだけになる
STRIPE_SECRET_KEY=
# Webhook の署名シークレット。参加費は運営の Stripe アカウントで受け取るので、Connect 用ではなく運営のアカウントのイベントを受け取る。
# 開発では `stripe listen --forward-to localhost:8000/api/stripe/webhook` が表示する whsec_...
# 本番ではダッシュボードで checkout.session.completed / checkout.session.expired / charge.refund.updated / refund.failed を登録する
STRIPE_WEBHOOK_SECRET=
# Stripe の支払い画面から戻ってくるフロントエンドの URL
FRONTEND_BASE_URL=http://localhost:5173
# 運営の手数料(参加費に対する %)。残りが主催者の売上になる。Stripe の決済手数料は運営が負担する
PLATFORM_FEE_PERCENT=10
# 主催者が振込を申請できる最低額と、振込1回ごとの振込手数料(主催者の負担。最低額未満にする)。
# 手数料率・最低額・振込手数料を変えたら、ガイドラインの表示用の frontend/src/utils/payment.ts も直す
PAYOUT_MIN_AMOUNT=1000
PAYOUT_TRANSFER_FEE=250
